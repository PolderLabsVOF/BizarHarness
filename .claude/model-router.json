{
  "$schema": "https://bizar.dev/schema/model-router.v1.json",
  "version": "11.0.0",
  "endpoint": "http://localhost:20128/v1",
  "comment": "Single local router. Set BIZAR_MODEL_ROUTER_URL or ANTHROPIC_BASE_URL to override. Models discovered live from /v1/models.",
  "tiers": {
    "premium": {
      "models": ["cx/gpt-5.6-sol"],
      "purpose": "Complex debugging, planning work, UI design language, deep review — heaviest reasoning, highest cost."
    },
    "high": {
      "models": ["cx/gpt-5.6-terra"],
      "purpose": "Complex implementation, routing, architecture — high reasoning at lower cost than sol."
    },
    "mid-design": {
      "models": ["cx/gpt-5.6-luna"],
      "purpose": "Design critique alt — visually-oriented mid-tier."
    },
    "default": {
      "models": ["bizar/MiniMax-M3"],
      "purpose": "Everyday default — fast general-purpose reasoning."
    },
    "mid": {
      "models": ["bizar/MiniMax-M2.7"],
      "purpose": "Mid-complexity implementation, research — slightly cheaper than default."
    },
    "budget": {
      "models": ["bizar/MiniMax-M2.5", "oc/deepseek-v4-flash-free", "oc/mimo-v2.5-free"],
      "purpose": "Trivial lookups, mechanical edits, clarifying questions — lowest cost."
    }
  },
  "agents": {
    "agent-browser": { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Browser driving is mechanical + reactive." },
    "baldr":         { "model": "cx/gpt-5.6-sol",  "tier": "premium", "rationale": "UI design language needs the highest reasoning." },
    "forseti":       { "model": "cx/gpt-5.6-sol",  "tier": "premium", "rationale": "Plan review + audit; weakest reasoning is the bottleneck." },
    "frigg":         { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Read-only Q&A — fast default." },
    "heimdall":      { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Mechanical edits and .bizar/ maintenance." },
    "hermod":        { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Git/GitHub ops — command templates." },
    "mimir":         { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Codebase research — sheer volume, cheap model wins." },
    "odin":          { "model": "cx/gpt-5.6-terra","tier": "high",    "rationale": "Routing + decomposition; high reasoning required." },
    "quick":         { "model": "oc/deepseek-v4-flash-free", "tier": "budget", "rationale": "Single-shot tiny tasks — budget tier." },
    "semble-search": { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Semantic code search — default reasoning." },
    "thor":          { "model": "bizar/MiniMax-M2.7","tier": "mid",     "rationale": "Mid-complexity implementation; cheaper than default." },
    "tyr":           { "model": "cx/gpt-5.6-terra","tier": "high",    "rationale": "Top-tier implementation; high reasoning." },
    "vidarr":        { "model": "cx/gpt-5.6-sol",  "tier": "premium", "rationale": "Last-resort debug — strongest reasoning." },
    "vor":           { "model": "oc/mimo-v2.5-free", "tier": "budget", "rationale": "Clarifying question; budget tier." }
  },
  "policies": {
    "gpt_only_for": ["complex debugging", "planning work", "UI design language", "deep review", "routing/decomposition"],
    "gpt_never_for": ["research", "implementation", "everyday tasks", "Q&A", "mechanical edits"],
    "fallback_chain": ["cx/gpt-5.6-sol", "cx/gpt-5.6-terra", "cx/gpt-5.6-luna", "bizar/MiniMax-M3", "bizar/MiniMax-M2.7", "bizar/MiniMax-M2.5", "oc/deepseek-v4-flash-free", "oc/mimo-v2.5-free"],
    "escalate_on_failure": true,
    "cost_ceiling_per_session_usd": 5.0
  }
}