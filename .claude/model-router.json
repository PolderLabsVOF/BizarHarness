{
  "$schema": "https://bizar.dev/schema/model-router.v1.json",
  "version": "11.0.0",
  "endpoint": "http://localhost:20128/v1",
  "comment": "Gateway model discovery is enabled at install time; the /model picker surfaces only IDs prefixed with \"claude\" or \"anthropic\". Run \"bizar model list\" to see the full set.",
  "tiers": {
    "premium": {
      "models": ["cx/gpt-5.6-sol"],
      "purpose": "Complex debugging, planning work, UI design language, deep review — heaviest reasoning, highest cost."
    },
    "high": {
      "models": ["cx/gpt-5.6-terra"],
      "purpose": "Complex implementation, routing, architecture — high reasoning at lower cost than sol."
    },
    "mid-design": {
      "models": ["cx/gpt-5.6-luna"],
      "purpose": "Design critique alt — visually-oriented mid-tier."
    },
    "default": {
      "models": ["bizar/MiniMax-M3"],
      "purpose": "Everyday default — fast general-purpose reasoning."
    },
    "mid": {
      "models": ["bizar/MiniMax-M2.7"],
      "purpose": "Mid-complexity implementation, research — slightly cheaper than default."
    },
    "budget": {
      "models": ["bizar/MiniMax-M2.5", "oc/deepseek-v4-flash-free", "oc/mimo-v2.5-free"],
      "purpose": "Trivial lookups, mechanical edits, clarifying questions — lowest cost."
    }
  },
  "agents": {
    "kevin": { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Browser driving is mechanical + reactive." },
    "brad":         { "model": "cx/gpt-5.6-sol",  "tier": "premium", "rationale": "UI design language needs the highest reasoning." },
    "linda":       { "model": "cx/gpt-5.6-sol",  "tier": "premium", "rationale": "Plan review + audit; weakest reasoning is the bottleneck." },
    "susan":         { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Read-only Q&A — fast default." },
    "brenda":      { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Mechanical edits and .bizar/ maintenance." },
    "steve":        { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Git/GitHub ops — command templates." },
    "greg":         { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Codebase research — sheer volume, cheap model wins." },
    "mike":          { "model": "cx/gpt-5.6-terra","tier": "high",    "rationale": "Routing + decomposition; high reasoning required." },
    "pam":         { "model": "oc/deepseek-v4-flash-free", "tier": "budget", "rationale": "Single-shot tiny tasks — budget tier." },
    "oscar": { "model": "bizar/MiniMax-M3", "tier": "default", "rationale": "Semantic code search — default reasoning." },
    "todd":          { "model": "bizar/MiniMax-M2.7","tier": "mid",     "rationale": "Mid-complexity implementation; cheaper than default." },
    "karen":           { "model": "cx/gpt-5.6-terra","tier": "high",    "rationale": "Top-tier implementation; high reasoning." },
    "carl":        { "model": "cx/gpt-5.6-sol",  "tier": "premium", "rationale": "Last-resort debug — strongest reasoning." },
    "janet":           { "model": "oc/mimo-v2.5-free", "tier": "budget", "rationale": "Clarifying question; budget tier." },
    "paul":            { "model": "cx/gpt-5.6-sol",  "tier": "premium", "rationale": "Default planner for every non-trivial session. Planning quality is the bottleneck for downstream impl cost — premium reasoning wins." },
    "ria":             { "model": "cx/gpt-5.6-sol",  "tier": "premium", "rationale": "UI/UX design craft — typography, spacing, motion, anti-slop. Same reasoning budget as @brad." }
  },
  "policies": {
    "gpt_only_for": ["complex debugging", "planning work", "default planning", "UI design language", "UI/UX craft", "deep review", "routing/decomposition"],
    "gpt_never_for": ["research", "implementation", "everyday tasks", "Q&A", "mechanical edits"],
    "fallback_chain": ["cx/gpt-5.6-sol", "cx/gpt-5.6-terra", "cx/gpt-5.6-luna", "bizar/MiniMax-M3", "bizar/MiniMax-M2.7", "bizar/MiniMax-M2.5", "oc/deepseek-v4-flash-free", "oc/mimo-v2.5-free"],
    "escalate_on_failure": true,
    "cost_ceiling_per_session_usd": 5.0
  }
}