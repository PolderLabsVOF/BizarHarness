{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "mcpServers": {
    "bizar": {
      "command": "npx",
      "args": [
        "-y",
        "@polderlabs/bizar-sdk",
        "mcp"
      ],
      "env": {
        "BIZAR_HOME": "${HOME}/.config/bizar"
      }
    },
    "semble": {
      "command": "semble",
      "args": [
        "mcp"
      ]
    },
    "agent-browser": {
      "command": "agent-browser",
      "args": [
        "mcp"
      ]
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "mcp__bizar__plan_action",
      "mcp__bizar__loop_list",
      "mcp__bizar__loop_status",
      "mcp__bizar__loop_start",
      "mcp__bizar__loop_stop",
      "mcp__bizar__graph_query",
      "mcp__bizar__graph_path",
      "mcp__bizar__list_instincts",
      "mcp__bizar__list_decisions",
      "mcp__bizar__bizar_task",
      "mcp__bizar__bizar_workflow",
      "mcp__bizar__bizar_control",
      "mcp__bizar__bizar_audit",
      "mcp__bizar__bizar_model_list",
      "mcp__semble__*",
      "mcp__agent-browser__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(rm -rf /)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push -f *)",
      "Bash(git rebase *)",
      "Bash(git -C * rebase *)",
      "Bash(git --git-dir=* rebase *)",
      "Write(./node_modules/**)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git --git-dir=* commit *)",
      "Bash(git --git-dir=* push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr review *)",
      "Bash(gh pr comment *)",
      "Bash(gh release *)",
      "Bash(npm publish *)",
      "Bash(bun publish *)",
      "Bash(vercel deploy *)",
      "Bash(wrangler deploy *)",
      "Bash(pnpm publish *)",
      "Bash(flyctl deploy *)"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: the current repository and its configured remotes.",
      "Development scope: local files, tests, builds, and declared dependencies in the current repository."
    ],
    "allow": [
      "$defaults",
      "Local reversible edits and test/build commands within the current repository.",
      "Installing dependencies already declared by repository manifests without changing those manifests.",
      "Read-only Git, GitHub, documentation, and package-registry operations."
    ],
    "soft_deny": [
      "$defaults",
      "Commits, pushes, pull-request mutations, releases, package publication, or deployments without the configured human approval hook.",
      "Force push, rebase, remote branch deletion, or other history rewriting.",
      "Production or shared-infrastructure writes, credential changes, public exposure, or irreversible local destruction."
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "worktree": {
    "baseRef": "head",
    "cleanupPeriodDays": 7
  },
  "enableWorkflows": true,
  "alwaysThinkingEnabled": true,
  "autoDreamEnabled": true,
  "showThinkingSummaries": true,
  "env": {
    "BIZAR_HOME": "${HOME}/.config/bizar",
    "ANTHROPIC_BASE_URL": "http://localhost:20129/v1",
    "BIZAR_MODEL_ROUTER_URL": "http://localhost:20128/v1",
    "ANTHROPIC_AUTH_TOKEN": "sk_9router",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook pre-tool-use",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook permission-request",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook post-tool-use",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook post-tool-use-failure",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook subagent-start",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook subagent-stop",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook pre-compact",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bizar hook session-end",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
