# ── Node ────────────────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ── Per-user cline config (contains API tokens, do not commit) ──────────
config/cline.json

# ── Vite build output (compiled React SPA) ──────────────────────────────────
dist/

# ── Cline runtime state ──────────────────────────────────────────────────
.cline/

# ── Embedded upstream clones (not part of BizarHarness) ──────────────────
ruflo/

# ── Skills CLI caches (generated by `npx skills add ... --all`) ────────────
.agents/
/agent/

# ── OMX runtime state ──────────────────────────────────────────────────────
.omx/

# ── Old per-project Obsidian vault (replaced by managed mode at ────────────
# ~/.local/share/bizar/memory/<repo>/)
.obsidian/

# ── Nested Bizar project repo (separate git history) ──────────────────────
bizar-mods/

# ── Per-project Bizar data folder ──────────────────────────────────────────
# Everything under .bizar/ is generated state — agent memories, KB notes,
# screenshots, plan outputs, scripts. Per-machine, never pushed.
.bizar/

# ── Broken literal ${HOME} folder (unexpanded shell var that leaked into
# the working tree at some point; git treats it as a literal directory name)
${HOME}/

# ── Test fixtures and scratch ──────────────────────────────────────────────
*.log
*.tgz

# ── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.dbbizar-dash/undefined/
.harness/traces/
.harness/agents.json
.harness/topology.json

# ── Auto-generated from .md by cli/provision.mjs:mdToClineAgentYaml() ───
# Source of truth is the .md file. Delete the .yaml and re-run the
# installer (or `bizar update`) to regenerate.
config/agents/*.yaml
config/agents/*.yml

# ── Dashboard scratch (local canvas/design artifacts, not source) ──────
bizar-dash/.openkan/
bizar-dash/bizar-design/
bizar-dash/*.artifact.json

# ── Personal notes (project-level scratch) ──────────────────────────────
.clinerules
.harness/evals/*.jsonl
