# ── Node ────────────────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ── Per-user cline config (contains API tokens, do not commit) ──────────
config/cline.json

# ── Vite build output (compiled React SPA) ──────────────────────────────────
dist/

# ── Cline runtime state ──────────────────────────────────────────────────
.cline/

# ── Skills CLI caches (generated by `npx skills add ... --all`) ────────────
.agents/
agent/

# ── OMX runtime state ──────────────────────────────────────────────────────
.omx/

# ── Old per-project Obsidian vault (replaced by managed mode at ────────────
# ~/.local/share/bizar/memory/<repo>/)
.obsidian/

# ── Nested Bizar project repo (separate git history) ──────────────────────
bizar-mods/

# ── Per-project Bizar data folder ──────────────────────────────────────────
# Everything under .bizar/ is generated state — agent memories, KB notes,
# screenshots, plan outputs, scripts. Per-machine, never pushed.
.bizar/

# ── Test fixtures and scratch ──────────────────────────────────────────────
*.log
*.tgz

# ── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.dbbizar-dash/undefined/
.harness/traces/
