node_modules/
package-lock.json

# Plans (gitignored — regenerable from plan.mdx)
plans/*/plan.html
plans/*/comments.json

# Per-user opencode config (contains API tokens, do not commit)
# Use config/opencode.json.template as a starting point
config/opencode.json

# Vite build output (compiled React SPA)
dist/

# Per-user state (activity logs, internal investigation notes)
# Per-project data — generated by the Bizar plugin
.bizar/activity.log
.bizar/opencode-sse-investigation.md
# Knowledge graph — generated by `bizar graph build`, gitignored because
# it changes on every build and is large (~1.4 MB). Run `bizar graph build`
# on first use to populate.
.bizar/graph/

# Opencode runtime state
.opencode/

# Test fixtures and scratch
*.log
*.tgz

# bizarre-mods lives in this directory for development convenience but is
# tracked as its own standalone repo at github.com/DrB0rk/bizarre-mods.
# It's untracked here so the parent repo doesn't see duplicate history.
bizar-mods/

