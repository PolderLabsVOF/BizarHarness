# Exclude test files from npm tarball
cli/*.test.mjs

# Source maps — only ship hidden sourcemaps (sourcemap: 'hidden' in vite.config)
bizar-dash/dist/**/*.map

# Test files
**/__tests__/
**/*.test.mjs
**/*.test.ts
**/*.test.tsx

# Internal design docs (not for npm)
.bizar/

# Project plans (user data, not package)
.bizar/plans/

# GitHub wiki (lives on GitHub)
wiki/

# Standard npmignore
node_modules/
*.log
.DS_Store

# Templates shipped with the package
!templates/plan/htmx.min.js
