{
  "name": "@polderlabs/bizar-dash",
  "version": "3.21.0",
  "description": "Web + TUI dashboard for the Bizar agent platform (optional companion to @polderlabs/bizar)",
  "type": "module",
  "main": "src/server/server.mjs",
  "exports": {
    ".": "./src/server/server.mjs",
    "./dash-cli": "./src/cli.mjs"
  },
  "files": [
    "src/",
    "dist/",
    "vite.config.ts",
    "tsconfig.json",
    "templates/"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck || echo '⚠ typecheck reported warnings above — review before tagging a release'; npm run build"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@xyflow/react": "^12.11.1",
    "blessed": "^0.1.81",
    "chokidar": "^3.6.0",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "express": "^4.22.0",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.460.0",
    "qrcode-terminal": "^0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
