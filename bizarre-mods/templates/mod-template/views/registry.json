/**
 * my-mod/views/registry.json — declarative tab registrations.
 *
 * Each entry becomes a top-bar entry in the dashboard. The icon
 * field accepts any lucide-react name.
 */
{
  "views": [
    {
      "id": "my-mod-main",
      "label": "My Mod",
      "icon": "Star",
      "description": "Tab description shown on hover.",
      "component": "MainView.tsx"
    }
  ]
}