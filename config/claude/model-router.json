{
  "$schema": "https://bizar.dev/schema/model-router.v3.json",
  "version": "13.0.0",
  "endpoint": "http://localhost:20129/v1",
  "comment": "Mike selects the cheapest sufficient user-selected model per dispatch. Agent roles never carry fixed models. The orchestrator dispatches ONLY with IDs in `userSelected.models`. When `userSelected` is empty, omit the Agent model override and inherit the active session model instead of retrying aliases.",
  "userSelected": {
    "models": [],
    "lastUpdated": null,
    "source": "default-empty",
    "tierHints": {}
  },
  "gateway": {
    "required": false,
    "endpoint": "http://localhost:20129/v1",
    "availabilityProbe": "/models",
    "discoveryTimeoutMs": 3000,
    "unavailableBehavior": "inherit-session",
    "documentation": "https://code.claude.com/docs/en/llm-gateway"
  },
  "tiers": {
    "premium": {
      "models": [
        "claude-qwen/qwen3.8-max",
        "cx/gpt-5.6-terra"
      ],
      "purpose": "Architecture, high-risk planning, adversarial verification, and last-resort debugging where mistakes are expensive.",
      "effort": "high"
    },
    "high": {
      "models": [
        "cx/gpt-5.6-terra",
        "claude-qwen/qwen3.8-max"
      ],
      "purpose": "Complex implementation, security review, and cross-cutting reasoning.",
      "effort": "high"
    },
    "mid-design": {
      "models": [
        "cx/gpt-5.6-luna",
        "claude-minimax/MiniMax-M3"
      ],
      "purpose": "UI/UX design and product-quality implementation where visual judgment matters.",
      "effort": "medium"
    },
    "default": {
      "models": [
        "claude-minimax/MiniMax-M3",
        "claude-minimax/MiniMax-M2.7"
      ],
      "purpose": "Broad research, git operations, and ordinary engineering work.",
      "effort": "medium"
    },
    "mid": {
      "models": [
        "claude-minimax/MiniMax-M2.7",
        "claude-minimax/MiniMax-M3"
      ],
      "purpose": "Bounded technical analysis, code search, and moderate implementation.",
      "effort": "medium"
    },
    "budget": {
      "models": [
        "claude-minimax/MiniMax-M2.5",
        "claude-minimax/MiniMax-M2.7"
      ],
      "purpose": "Routine deterministic edits, targeted clarification, and scripted verification.",
      "effort": "low"
    }
  },
  "roleDefaults": {
    "mike": "premium",
    "paul": "premium",
    "carl": "premium",
    "karen": "high",
    "linda": "high",
    "ria": "mid-design",
    "greg": "default",
    "steve": "default",
    "oscar": "mid",
    "todd": "mid",
    "susan": "mid",
    "pam": "budget",
    "brenda": "budget",
    "janet": "budget",
    "kevin": "budget",
    "brad": "mid-design"
  },
  "complexityRules": [
    {
      "when": "irreversible, security-sensitive, architectural, or previously failed twice",
      "tier": "premium"
    },
    {
      "when": "cross-cutting implementation or adversarial review",
      "tier": "high"
    },
    {
      "when": "UI or product design judgment dominates",
      "tier": "mid-design"
    },
    {
      "when": "bounded implementation or codebase research",
      "tier": "mid"
    },
    {
      "when": "deterministic, mechanical, or clarification-only",
      "tier": "budget"
    }
  ],
  "policies": {
    "mainOrchestrator": "mike",
    "selectionOwner": "orchestrator",
    "dispatchModelOverride": "allowed-when-discovered",
    "unknownAgent": "inherit-session",
    "discoveryFailure": "inherit-session",
    "unavailableModel": "inherit-session",
    "silentProviderSubstitution": false,
    "retryModelAliases": false,
    "snapshotDecisions": true,
    "maxDispatchModelAttempts": 1
  },
  "costControls": {
    "maxConcurrentAgents": 10,
    "maxPremiumAgentsPerWorkflow": 3,
    "preferInheritanceWhenDiscoveryUnavailable": true
  }
}
