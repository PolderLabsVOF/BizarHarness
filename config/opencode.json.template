{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax/MiniMax-M3",
  "small_model": "minimax/MiniMax-M2.7",
  "default_agent": "odin",
  "permission": "allow",
  "snapshot": false,
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp",
      "enabled": false
    },
    "hindsight": {
      "type": "remote",
      "url": "https://memory-api.polderlabs.io/mcp",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer __HINDSIGHT_BEARER_TOKEN__",
        "Content-Type": "application/json"
      }
    },
    "semble": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "semble[mcp]",
        "semble"
      ],
      "enabled": true
    }
  },
  "plugin": [
    ["./plugins/bizar/index.ts", {
      "loopThresholdWarn": 5,
      "loopThresholdEscalate": 8,
      "loopThresholdBlock": 12,
      "loopWindowSize": 10
    }]
  ],
  "tools": {
    "bizar_plan_action": true,
    "bizar_get_plan_comments": true,
    "bizar_wait_for_feedback": true,
    "bizar_spawn_background": true,
    "bizar_status": true,
    "bizar_collect": true,
    "bizar_kill": true
  },
  "agent": {
    "odin": {
      "description": "Odin — Pure router that delegates all work to subagents.",
      "mode": "primary",
      "model": "minimax/MiniMax-M3",
      "color": "#6366f1",
      "permission": {
        "task": "allow",
        "read": "allow",
        "list": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "vor": {
      "description": "Vör — The Questioning One.",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.7",
      "color": "#8b5cf6",
      "permission": {
        "read": "allow",
        "list": "allow",
        "question": "allow",
        "hindsight_recall": "allow",
        "hindsight_retain": "allow"
      }
    },
    "frigg": {
      "description": "Frigg — All-knowing Q&A agent.",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.7",
      "color": "#06b6d4",
      "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "hindsight_recall": "allow",
        "hindsight_retain": "allow",
        "question": "allow"
      }
    },
    "quick": {
      "description": "Quick — Fast single-shot tasks.",
      "mode": "primary",
      "model": "minimax/MiniMax-M2.7",
      "color": "#22d3ee",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "deny"
      }
    },
    "mimir": {
      "description": "Mimir — Research and codebase exploration agent.",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.7",
      "color": "#0ea5e9",
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "todowrite": "allow"
      }
    },
    "heimdall": {
      "description": "Heimdall — Simple, routine, deterministic tasks.",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.7",
      "color": "#10b981",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "hermod": {
      "description": "Hermod — Git and GitHub operations specialist.",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.7",
      "color": "#06b6d4",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "thor": {
      "description": "Thor — Medium-complexity tasks, strong and reliable.",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.7",
      "color": "#a855f7",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "baldr": {
      "description": "Baldr — UI/UX design system specialist.",
      "mode": "subagent",
      "model": "minimax/MiniMax-M2.7",
      "color": "#ec4899",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "tyr": {
      "description": "Tyr — Complex implementation, debugging, architecture.",
      "mode": "subagent",
      "model": "minimax/MiniMax-M3",
      "color": "#f59e0b",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "vidarr": {
      "description": "Vidarr — Ultimate fallback via GPT-5.5.",
      "mode": "subagent",
      "model": "openai/gpt-5.5",
      "color": "#dc2626",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "forseti": {
      "description": "Forseti — Audits and corrects plans before execution.",
      "mode": "subagent",
      "model": "minimax/MiniMax-M3",
      "color": "#ef4444",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "semble-search": {
      "description": "Code search agent for exploring any codebase.",
      "mode": "subagent",
      "permission": {
        "bash": "allow",
        "read": "allow"
      }
    }
  },
  "command": {
    "audit": {
      "description": "Run bizar audit to scan agent configuration for security issues.",
      "agent": "forseti",
      "template": "commands-bizar/audit.md"
    },
    "explain": {
      "description": "Route to @frigg for read-only codebase Q&A.",
      "agent": "frigg",
      "template": "commands-bizar/explain.md"
    },
    "init": {
      "description": "Run bizar init to detect project stack and install skills.",
      "agent": "heimdall",
      "template": "commands-bizar/init.md"
    },
    "learn": {
      "description": "Extract patterns from current session.",
      "agent": "heimdall",
      "template": "commands-bizar/learn.md"
    },
    "plan": {
      "description": "Open the Bizar visual plan canvas.",
      "agent": "odin",
      "template": "commands-bizar/plan.md"
    },
    "pr-review": {
      "description": "PR review mode with @mimir and @forseti.",
      "agent": "hermod",
      "template": "commands-bizar/pr-review.md"
    },
    "tailscale-serve": {
      "description": "Authenticate Tailscale Serve and expose a local port.",
      "agent": "heimdall",
      "template": "commands-bizar/tailscale-serve.md"
    },
    "visual-plan": {
      "description": "Toggle the Bizar visual plan canvas.",
      "agent": "odin",
      "template": "commands-bizar/visual-plan.md"
    },
    "bizar": {
      "description": "Bizar Plugin Menu.",
      "agent": "odin",
      "template": "commands-bizar/bizar.md\n\n$ARGUMENTS"
    }
  },
  "provider": {
    "minimax": {
      "models": {
        "MiniMax-M3": {
          "interleaved": { "field": "reasoning_details" },
          "reasoning": true,
          "options": {
            "thinking": "adaptive"
          }
        },
        "MiniMax-M2.7": {
          "interleaved": { "field": "reasoning_details" },
          "reasoning": true,
          "options": {
            "thinking": "adaptive"
          }
        }
      }
    }
  }
}
