{
  "name": "@polderlabs/bizar",
  "version": "3.9.1",
  "description": "Norse-pantheon multi-agent system for opencode — 13 agents across 4 cost tiers with cost-aware routing, plans, and a configurable agent harness.",
  "type": "module",
  "bin": {
    "bizar": "cli/bin.mjs"
  },
  "files": [
    "cli/",
    "config/",
    "templates/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "ai-agent",
    "norse",
    "multi-agent",
    "router",
    "cli",
    "platform",
    "mods",
    "schedules"
  ],
  "license": "MIT",
  "dependencies": {
    "boxen": "^8.0.0",
    "chalk": "^5.4.0",
    "inquirer": "^12.0.0",
    "ora": "^8.1.0"
  },
  "peerDependencies": {
    "@polderlabs/bizar-dash": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@polderlabs/bizar-dash": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:DrB0rk/BizarHarness.git"
  },
  "bugs": {
    "url": "https://github.com/DrB0rk/BizarHarness/issues"
