{
  "name": "@polderlabs/bizar",
  "version": "2.5.1",
  "description": "Norse-pantheon multi-agent system for opencode — 13 agents across 4 cost tiers with cost-aware routing and per-project Hindsight memory",
  "type": "module",
  "bin": {
    "bizar": "cli/bin.mjs"
  },
  "files": [
    "cli/",
    "config/",
    "dist/",
    "src/",
    "templates/",
    "vite.config.ts",
    "tsconfig.json",
    "!cli/*.test.mjs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "postinstall": "node cli/bin.mjs --postinstall"
  },
  "keywords": [
    "opencode",
    "ai-agent",
    "norse",
    "multi-agent",
    "router",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "boxen": "^8.0.0",
    "chalk": "^5.4.0",
    "chokidar": "^3.6.0",
    "express": "^4.22.2",
    "inquirer": "^12.0.0",
    "lucide-react": "^0.460.0",
    "ora": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrB0rk/BizarHarness.git"
  },
  "homepage": "https://github.com/DrB0rk/BizarHarness",
  "bugs": {
    "url": "https://github.com/DrB0rk/BizarHarness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
