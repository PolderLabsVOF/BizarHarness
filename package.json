{
  "name": "@polderlabs/bizar",
  "version": "10.7.2",
  "description": "Autonomous, human-in-the-loop multi-agent harness for Claude Code with guarded workflows, typed SDK primitives, and MCP tools.",
  "type": "module",
  "bin": {
    "bizar": "cli/bin.mjs"
  },
  "files": [
    "cli/",
    "packages/sdk/",
    "config/",
    "templates/",
    "scripts/",
    "install.sh",
    ".claude/agents/",
    ".claude/skills/",
    ".claude/commands/",
    ".claude/hooks/",
    ".claude/settings.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:sdk": "node scripts/clean-sdk-dist.mjs && tsc -p packages/sdk/tsconfig.json",
    "test:sdk": "node_modules/.bin/vitest run --root packages/sdk",
    "test:sdk:watch": "node_modules/.bin/vitest --root packages/sdk",
    "test:node": "node scripts/run-node-tests.mjs",
    "test": "npm run build:sdk && npm run test:sdk && npm run test:node",
    "build": "npm run build:sdk",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "claude-agent-sdk",
    "ai-agent",
    "multi-agent",
    "router",
    "cli",
    "platform",
    "autonomy",
    "human-in-the-loop",
    "mcp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.4.0",
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DrB0rk/BizarHarness.git"
  },
  "bugs": {
    "url": "https://github.com/DrB0rk/BizarHarness/issues"
  },
  "homepage": "https://github.com/DrB0rk/BizarHarness#readme",
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0"
  }
}
