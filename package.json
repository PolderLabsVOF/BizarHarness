{
  "name": "@polderlabs/bizar",
  "version": "3.0.0",
  "description": "Norse-pantheon multi-agent system for opencode — 13 agents across 4 cost tiers with cost-aware routing, per-project Hindsight memory, mods, schedules, and a background service daemon",
  "type": "module",
  "bin": {
    "bizar": "cli/bin.mjs",
    "install": "cli/bin.mjs"
  },
  "files": [
    "cli/",
    "config/",
    "templates/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "postinstall": "node cli/bin.mjs --postinstall"
  },
  "keywords": [
    "opencode",
    "ai-agent",
    "norse",
    "multi-agent",
    "router",
    "cli",
    "platform",
    "mods",
    "schedules"
  ],
  "license": "MIT",
  "dependencies": {
    "boxen": "^8.0.0",
    "chalk": "^5.4.0",
    "inquirer": "^12.0.0",
    "ora": "^8.1.0"
  },
  "peerDependencies": {
    "@polderlabs/bizar-dash": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@polderlabs/bizar-dash": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrB0rk/BizarHarness.git"
  },
  "homepage": "https://github.com/DrB0rk/BizarHarness",
  "bugs": {
    "url": "https://github.com/DrB0rk/BizarHarness/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^5.9.3"
  }
}
