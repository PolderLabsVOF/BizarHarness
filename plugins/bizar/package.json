{
  "name": "@polderlabs/bizarharness-plugin",
  "version": "0.3.0",
  "description": "Bizar opencode plugin — loop detection, status reporting, handoff signal, and stall/thinking-loop protection for subagent activity",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "check:imports": "bash scripts/check-forbidden-imports.sh",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:imports && bun test tests/loop.test.ts tests/block.test.ts tests/stall-think.test.ts"
  },
  "keywords": [
    "opencode",
    "plugin",
    "loop-detection",
    "agent-orchestration"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.7",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.0"
  }
}
