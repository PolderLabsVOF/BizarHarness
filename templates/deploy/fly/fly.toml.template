# fly.toml — Bizar dashboard
# Generated by `bizar deploy --to fly`

app = "bizar-dash"
primary_region = "iad"

[build]
  dockerfile = "../Dockerfile"

[http_service]
  internal_port = 4097
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
  min_machines_running = 0

[[vm]]
  memory = "512mb"
  cpu_kind = "shared"
  cpus = 1

[env]
  BIZAR_DASHBOARD_PORT = "4097"
  BIZAR_DASHBOARD_HOST = "0.0.0.0"
  NODE_ENV = "production"

[deploy]
  strategy = "rolling"
