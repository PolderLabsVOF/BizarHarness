{
  "id": "template-daily-cleanup",
  "name": "Daily cleanup",
  "description": "Clean up old backups and logs every day at 04:00",
  "type": "cron",
  "schedule": "0 4 * * *",
  "action": {
    "type": "command",
    "target": "bizar backup delete --older-than 30d"
  },
  "tags": ["backup", "maintenance", "cleanup"]
}
